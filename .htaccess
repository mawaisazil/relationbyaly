# ============================================================
# .htaccess — Relationships With Aly
# InfinityFree ke htdocs root mein daalo
# ============================================================

# ---------- Force HTTPS ----------
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ---------- Disable directory listing ----------
Options -Indexes

# ---------- Block direct access to sensitive files ----------
<FilesMatch "\.(htaccess|htpasswd|ini|log|sh|sql|bak|config|json|md)$">
  Order Allow,Deny
  Deny from all
</FilesMatch>

# ---------- Block access to hidden files ----------
RewriteRule "(^|/)\." - [F]

# ---------- Antibot / simple scraper block ----------
<IfModule mod_rewrite.c>
  RewriteCond %{HTTP_USER_AGENT} (HTTrack|wget|curl|python-requests|libwww-perl|scrapy|nikto|sqlmap) [NC]
  RewriteRule .* - [F,L]
</IfModule>

# ---------- Security headers ----------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header set X-XSS-Protection "1; mode=block"
  # Disable server signature leaking
  Header unset Server
  Header unset X-Powered-By
</IfModule>

# ---------- Prevent image hotlinking (except own domain + Google) ----------
RewriteCond %{HTTP_REFERER} !^$
RewriteCond %{HTTP_REFERER} !^https?://(www\.)?relationshipswithaly\.com [NC]
RewriteCond %{HTTP_REFERER} !^https?://(www\.)?google\. [NC]
RewriteCond %{HTTP_REFERER} !^https?://(www\.)?bing\. [NC]
RewriteRule \.(jpe?g|png|gif|webp|svg)$ - [F,NC]

# ---------- Long cache for static assets ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

# ---------- Compression ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/plain
</IfModule>
